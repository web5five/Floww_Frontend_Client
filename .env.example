# Floww_Server origin, server-only. Set actual values in .env.local.
FLOWW_API_BASE_URL=
# Optional protected Preview BFF access. Server only; never put this value in NEXT_PUBLIC_*.
FLOWW_SERVER_VERCEL_BYPASS_SECRET=
# Development Bearer credential, server-only. Never use NEXT_PUBLIC_ for this value.
FLOWW_SERVER_DEV_TOKEN=

# Team wallet login contract. Leave blank until the matching backend is configured.
# Set true only with the server wallet feature and matching origin enabled.
FLOWW_WALLET_AUTH_ENABLED=
# Must match the backend's allowed decimal chain IDs (comma separated).
FLOWW_WALLET_CHAIN_IDS=
# Team PR #24 uses team-jwt (default). local-session is the separate comparison implementation only.
FLOWW_WALLET_AUTH_MODE=
# Server-only 32-byte random key encoded as 64 hex characters for the encrypted HttpOnly session cookie.
FLOWW_SESSION_SECRET=
# Leave blank until the business server actually accepts client JWTs and enforces owner isolation.
FLOWW_BUSINESS_JWT_ENABLED=

# Optional public WalletConnect project ID used by the MetaMask toolkit connector; injected MetaMask works without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Magic embedded wallet publishable key only (pk_ prefix). Never place a Magic secret key here.
# Without a valid key the Magic email choice is visible but disabled before SDK or OTP calls.
NEXT_PUBLIC_MAGIC_PUBLISHABLE_KEY=

# Submission voice stays OFF. Only enable after separate provider/rules approval.
# Server enforcement also blocks manual ElevenLabs generation even when keys remain configured.
FLOWW_VOICE_ENABLED=false
# Public presentation only; Next.js requires a rebuild when this value changes.
NEXT_PUBLIC_FLOWW_VOICE_ENABLED=false

# Optional local-only ElevenLabs generation. Used by scripts/generate-voice.mjs, never the browser.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Voice conversation: server only; never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-mini
